        <mxCell id="refreshService" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontColor=#000000;" value="AccountRefreshService&#xa;(账号刷新)" vertex="1">
          <mxGeometry height="60" width="140" x="600" y="620" as="geometry" />
        </mxCell>
        <mxCell id="authSuccess" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;fontColor=#000000;" value="✅ 认证成功&#xa;返回用户信息" vertex="1">
          <mxGeometry height="60" width="140" x="820" y="380" as="geometry" />
