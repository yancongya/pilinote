{"version": "1.0.0", "name": "doc-debug", "description": "Documentation generation and debugging workflow", "defaults": {"maxIterations": 3, "autoFix": false, "timeout": {"testExecution": 300000, "elementVisibility": 5000, "pageLoad": 10000}, "testOptions": {"headless": true, "screenshot": "only-on-failure", "video": "retain-on-failure", "trace": "retain-on-failure"}}, "paths": {"output": ".workflow/doc-debug", "docs": "docs", "tests": "tests", "testResults": "test-results"}, "server": {"api": {"host": "localhost", "port": 8000, "healthCheck": "/api/health"}, "frontend": {"host": "localhost", "port": 5173, "healthCheck": "/"}}, "testCategories": {"api": {"endpointExistence": true, "authentication": true, "responseFormat": true, "dataStructure": true, "errorHandling": true, "fieldTypes": true, "fieldNames": true}, "ui": {"pageAccessibility": true, "componentRendering": true, "navigation": true, "authenticationStates": true, "userInteractions": true}, "documentation": {"routeConfiguration": true, "apiEndpoints": true, "dataModels": true, "authenticationMethods": true}}, "errorPatterns": {"apiEndpoint": {"statusCode": [404, 405], "keywords": ["not found", "method not allowed", "endpoint"]}, "authentication": {"statusCode": [401, 403], "keywords": ["unauthorized", "forbidden", "authentication"]}, "fieldType": {"keywords": ["expect(received).toBe", "typeof"], "types": ["string", "number", "boolean", "array", "object"]}, "fieldName": {"keywords": ["toHaveProperty", "Cannot read property", "undefined"]}, "selector": {"keywords": ["strict mode violation", "resolved to", "elements"]}}, "fixStrategies": {"apiEndpoint": {"priority": "critical", "autoFix": true, "requiresUserConfirmation": false}, "fieldName": {"priority": "critical", "autoFix": true, "requiresUserConfirmation": false}, "fieldType": {"priority": "critical", "autoFix": true, "requiresUserConfirmation": false}, "authentication": {"priority": "critical", "autoFix": true, "requiresUserConfirmation": false}, "selector": {"priority": "medium", "autoFix": true, "requiresUserConfirmation": false}, "routing": {"priority": "high", "autoFix": true, "requiresUserConfirmation": false}}, "report": {"format": "markdown", "include": {"summary": true, "issues": true, "corrections": true, "testResults": true, "filesModified": true, "recommendations": true, "nextSteps": true}, "screenshots": true, "apiResponses": true, "iterationLogs": true}, "integration": {"skills": ["project-documentation-workflow", "requesting-code-review", "frontend-tester"], "tools": ["playwright", "curl", "jq"]}}