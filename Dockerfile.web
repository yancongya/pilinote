FROM node:22-slim AS build
WORKDIR /build
RUN corepack enable
COPY apps/web/package.json apps/web/pnpm-lock.yaml ./
RUN corepack prepare pnpm@10.33.0 --activate && pnpm install --frozen-lockfile
COPY apps/web/ ./
RUN pnpm build

FROM nginx:stable-alpine
COPY --from=build /build/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/nginx.conf
USER 101
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
HEALTHCHECK --interval=15s --timeout=5s --retries=4 CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1
ARG PILINOTE_SOURCE_SHA256=unknown
LABEL com.itycon.pilinote.source-sha256="$PILINOTE_SOURCE_SHA256"
